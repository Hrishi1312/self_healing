# Copy to .env and fill in. .env is gitignored; this file is not, so keep it secret free.
#
#   cp testsenarion_selfhealing/tool/.env.example testsenarion_selfhealing/tool/.env
#   python3 testsenarion_selfhealing/tool/run_local.py 640764
#
# Names match the runinputs keys exactly, so what is here is what the tool receives.
# Any command line flag overrides the value here. A blank value is dropped and the
# tool's own default applies.

# ── stage ──────────────────────────────────────────────────────────────────
# all = whole pipeline in one call (default, same as the working copy).
# scenarios = story -> scenarios -> scenario review -> handoff file on GitHub.
# testcases = handoff file -> threads -> table. Needs only adostoryid + githubtoken.
stage=all
# The scenario reviewer agent. 0 = no scenario review. Its approval threshold is
# scenariopassscore (default 70), passed to the reviewer inside reviewinputs.
scenarioreviewagentid=0
scenariopassscore=

# ── credentials — never commit these ───────────────────────────────────────
aavatoken=
adopat=

# ── azure devops ───────────────────────────────────────────────────────────
adoorg=CSGRP
adoproject=ADO
adostoryid=640764

# ── sub agent ids ──────────────────────────────────────────────────────────
scenarioagentid=625
testcaseagentid=626
reviewagentid=627

# ── volume ─────────────────────────────────────────────────────────────────
# maxscenarios is MANDATORY: it sizes the whole run. Workers and the agent call
# budget follow it automatically — one thread per scenario, and
# maxagentcalls = 3 + maxscenarios x 2 x maxhealrounds — so there is no
# maxworkers key any more and nothing to calculate.
maxscenarios=1
testcasesperscenario=3
stepsmin=15
stepsmax=18

# ── healing and scoring ────────────────────────────────────────────────────
# maxhealrounds counts TOTAL passes, not repairs: 1 means no repair, 2 gives one.
maxhealrounds=2
passscore=80
hardstopscore=50
stoponstagnation=true

# ── budget — normally leave both blank ─────────────────────────────────────
# deadlineseconds defaults to 450: the 500s hosting ceiling minus margin to
# stop cleanly. maxagentcalls sizes itself from the run shape; a value here
# overrides the formula.
deadlineseconds=
maxagentcalls=

# ── github publish — off by default ────────────────────────────────────────
# publish=true pushes run.log, testcases.md, envelope.json and runinputs.json
# to tool_logs/<story>_<timestamp>/ in the repo below (or pass --publish).
# githubtoken needs contents write access; it is scrubbed from every log line.
publish=false
githubtoken=
githubrepo=Hrishi1312/self_healing
githubbranch=main

# ── platform ───────────────────────────────────────────────────────────────
aavabaseurl=https://aava-core-api-agents-svc.redtree-f4541a84.eastus.azurecontainerapps.io
realmid=
userprincipal=
