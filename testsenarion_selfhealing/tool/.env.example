# Copy to .env and fill in. .env is gitignored; this file is not, so keep it secret free.
#
#   cp testsenarion_selfhealing/tool/.env.example testsenarion_selfhealing/tool/.env
#   python3 testsenarion_selfhealing/tool/run_local.py 640764
#
# Names match the runinputs keys exactly, so what is here is what the tool receives.
# Any command line flag overrides the value here. A blank value is dropped and the
# tool's own default applies.

# ── credentials — never commit these ───────────────────────────────────────
aavatoken=
adopat=

# ── stage ──────────────────────────────────────────────────────────────────
# all = whole pipeline in one call (default, same as testgen_orchestrator).
# scenarios = story -> scenarios -> scenario review -> handoff file on GitHub.
# testcases = handoff file -> threads -> table. Needs only adostoryid + githubtoken.
stage=all

# ── azure devops ───────────────────────────────────────────────────────────
adoorg=CSGRP
adoproject=ADO
adostoryid=640764

# ── sub agent ids ──────────────────────────────────────────────────────────
# These must be the console agents carrying the CURRENT prompts. 01/02/03 live in
# testgen_orchestrator/agents/ and are shared, not copied; 04 is this folder's own.
# If you paste a prompt into a new console agent, update its id here.
scenarioagentid=688
testcaseagentid=689
reviewagentid=672
# The scenario reviewer agent (04). 0 = no scenario review. Its approval threshold is
# scenariopassscore (default 70), passed to the reviewer inside reviewinputs.
scenarioreviewagentid=704
scenariopassscore=

# ── volume ─────────────────────────────────────────────────────────────────
# maxscenarios is MANDATORY for stage=all and stage=scenarios: it sizes the whole
# run. Workers and the agent call budget follow it automatically — one thread per
# scenario, and maxagentcalls = 3 + maxscenarios x 2 x maxhealrounds — so there is
# no maxworkers key any more and nothing to calculate. 7 matches the breadth of the
# domain experts' reference output (26 test cases for story 640764); drop it first
# if runs start hitting the deadline. stage=testcases ignores it and takes the count
# from the handoff file instead.
maxscenarios=7
# testcasesperscenario is a BACKSTOP ceiling (default 6): the case count per scenario comes
# from that scenario's own "Conditions to cover" list — agent 01 declares it, agent 02 writes
# one case per entry. 6 is the largest genuine family in the experts' reference output; runs
# with 8+ got padded to the ceiling. Leave blank for the default.
testcasesperscenario=
# The reference output is front-loaded: one deep foundation case per story (the full
# baseline is ~20 steps after the file-naming/canonical/Facets-client steps landed
# 2026-08-27; the manual test cases run 23), then ~7-step variant cases that compress the
# shared pipeline plumbing. stepsmin 15 forced every case to re-walk the full flow and
# produced 5x the output size.
stepsmin=7
stepsmax=24

# ── healing and scoring ────────────────────────────────────────────────────
# maxhealrounds counts TOTAL passes, not repairs: 1 means no repair, 2 gives one.
# passscore must match the threshold wired into the reviewer prompt (90).
maxhealrounds=3
passscore=90
hardstopscore=50
stoponstagnation=true

# ── budget ─────────────────────────────────────────────────────────────────
# deadlineseconds defaults to 190: the 240s Azure Container Apps ceiling minus
# margin to stop cleanly. Splitting the run into two stages buys each stage its own
# window, but not a bigger one — the ceiling is per request either way. Runs launched
# OUTSIDE ACA (run_local.py) are not under that ceiling — 630 matches the platform
# runs published so far. Leave blank when the tool itself runs inside ACA.
# maxagentcalls sizes itself from the run shape; a value here overrides the formula.
deadlineseconds=630
maxagentcalls=

# ── github publish — off by default ────────────────────────────────────────
# publish=true pushes run.log, testcases.md, envelope.json and runinputs.json
# to tool_logs/<story>_<timestamp>/ in the repo below (or pass --publish).
# githubtoken needs contents write access; it is scrubbed from every log line.
# It is NOT optional for stage=scenarios or stage=testcases: the handoff file is
# the interface between them, not a convenience.
publish=false
githubtoken=
githubrepo=Hrishi1312/self_healing
githubbranch=main

# ── domain grounding — optional ────────────────────────────────────────────
# domainhints is a free-text glossary handed to every sub agent (segment/date
# mappings, terminology). Run 640764_141324 invented "Loop 2000 DTP01/DTP03" date
# names without it. bannedterms is a comma separated list the pre gate rejects
# from the assembled table (whole-token match, so DTP03 never fires inside DTP*303).
# The values below fit the 834 transaction-effective-date story family; adjust per story.
domainhints=Eligibility Date = Loop 2000 DTP*356/DTP*348. Assessment Date = Loop 2300 HD03. Maintenance Date = Loop 2000 DTP*303. Never name a date by a bare element position such as DTP01 or DTP03.
bannedterms=DTP01,DTP02,DTP03

# ── platform ───────────────────────────────────────────────────────────────
aavabaseurl=https://aava-core-api-agents-svc.redtree-f4541a84.eastus.azurecontainerapps.io
realmid=
userprincipal=
