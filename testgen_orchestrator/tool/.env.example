# Copy to .env and fill in. .env is gitignored; this file is not, so keep it secret free.
#
#   cp testgen_orchestrator/tool/.env.example testgen_orchestrator/tool/.env
#   python3 testgen_orchestrator/tool/run_local.py 640764
#
# Names match the runinputs keys exactly, so what is here is what the tool receives.
# Any command line flag overrides the value here.

# ── credentials — never commit these ───────────────────────────────────────
aavatoken=
adopat=

# ── azure devops ───────────────────────────────────────────────────────────
adoorg=CSGRP
adoproject=ADO
adostoryid=640764

# ── sub agent ids ──────────────────────────────────────────────────────────
scenarioagentid=625
testcaseagentid=626
reviewagentid=627

# ── volume ─────────────────────────────────────────────────────────────────
maxscenarios=1
testcasesperscenario=3
stepsmin=15
stepsmax=18

# ── healing and scoring ────────────────────────────────────────────────────
# maxhealrounds counts TOTAL passes, not repairs: 1 means no repair, 2 gives one.
maxhealrounds=2
passscore=80
hardstopscore=50
stoponstagnation=true

# ── budget ─────────────────────────────────────────────────────────────────
# Keep deadlineseconds below the platform ceiling so the tool stops on its own
# terms and returns partial results instead of being severed.
maxworkers=1
deadlineseconds=190
maxagentcalls=20

# ── platform ───────────────────────────────────────────────────────────────
aavabaseurl=https://aava-core-api-agents-svc.redtree-f4541a84.eastus.azurecontainerapps.io
realmid=
userprincipal=
