# Copy to .env and fill in. .env is gitignored; this file is not, so keep it secret free.
#
#   cp testgen_orchestrator/tool/.env.example testgen_orchestrator/tool/.env
#   python3 testgen_orchestrator/tool/run_local.py 640764
#
# Names match the runinputs keys exactly, so what is here is what the tool receives.
# Any command line flag overrides the value here. A blank value is dropped and the
# tool's own default applies.

# ── credentials — never commit these ───────────────────────────────────────
aavatoken=
adopat=

# ── azure devops ───────────────────────────────────────────────────────────
adoorg=CSGRP
adoproject=ADO
adostoryid=640764

# ── sub agent ids ──────────────────────────────────────────────────────────
# These must be the console agents carrying the CURRENT prompts (01/02/03 in
# agents/). If you paste a prompt into a new console agent, update its id here.
scenarioagentid=625
testcaseagentid=652
reviewagentid=627

# ── volume ─────────────────────────────────────────────────────────────────
# maxscenarios is MANDATORY: it sizes the whole run. Workers and the agent call
# budget follow it automatically — one thread per scenario, and
# maxagentcalls = 3 + maxscenarios x 2 x maxhealrounds — so there is no
# maxworkers key any more and nothing to calculate. 7 matches the breadth of the
# domain experts' reference output (26 test cases for story 640764); drop it
# first if runs start hitting the deadline.
maxscenarios=7
# testcasesperscenario is a CEILING, not a target (default 8): the generator writes one
# test case per genuinely distinct condition a scenario supports, up to this many. Leave
# blank for the default; there is no Positive/Negative/Edge split to configure any more.
testcasesperscenario=
stepsmin=15
stepsmax=18

# ── healing and scoring ────────────────────────────────────────────────────
# maxhealrounds counts TOTAL passes, not repairs: 1 means no repair, 2 gives one.
# passscore must match the threshold wired into the reviewer prompt (90).
maxhealrounds=3
passscore=90
hardstopscore=50
stoponstagnation=true

# ── budget ─────────────────────────────────────────────────────────────────
# deadlineseconds defaults to 190: the 240s Azure Container Apps ceiling minus
# margin to stop cleanly. Runs launched OUTSIDE ACA (run_local.py) are not under
# that ceiling — 630 matches the platform runs published so far. Leave blank when
# the tool itself runs inside ACA. maxagentcalls sizes itself from the run shape;
# a value here overrides the formula.
deadlineseconds=630
maxagentcalls=

# ── github publish — off by default ────────────────────────────────────────
# publish=true pushes run.log, testcases.md, envelope.json and runinputs.json
# to tool_logs/<story>_<timestamp>/ in the repo below (or pass --publish).
# githubtoken needs contents write access; it is scrubbed from every log line.
publish=false
githubtoken=
githubrepo=Hrishi1312/self_healing
githubbranch=main

# ── platform ───────────────────────────────────────────────────────────────
aavabaseurl=https://aava-core-api-agents-svc.redtree-f4541a84.eastus.azurecontainerapps.io
realmid=
userprincipal=
